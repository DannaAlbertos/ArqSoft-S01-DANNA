@model List<Catalogo.Models.Item>
<h1>Mi Catálogo</h1>
<!-- Filtro por género -->

<hr />
<!-- Lista de items -->
<ul>
    @foreach (var item in Model)
    {
        <li>
            <a asp-action="Detalle" asp-route-id="@item.Id">@item.Modelo</a>-- @item.Marca (@item.Ano)
        </li>
    }
</ul>
<hr />
<a asp-action="Agregar">+ Agregar Videojuego</a>
