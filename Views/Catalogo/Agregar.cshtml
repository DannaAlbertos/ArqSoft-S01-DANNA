@model Catalogo.Models.Item

@{
    ViewData["Title"] = "Agregar Carro";
}

<div class="container" style="padding: 40px 20px;">
    <div style="max-width: 600px; margin: 0 auto;">
        <h1 style="font-size: 2rem; margin-bottom: 30px;">Agregar Nuevo Carro</h1>

        <form asp-action="Agregar" method="post" style="background: rgba(220, 38, 38, 0.05); padding: 30px; border-radius: 12px;">
            <div style="margin-bottom: 20px;">
                <label style="display: block; margin-bottom: 8px; font-weight: bold;">Modelo</label>
                <input asp-for="Modelo" style="width: 100%; padding: 10px; border: 2px solid #dc2626; border-radius: 6px;" placeholder="Ej: Ferrari F8 Tributo" />
            </div>

            <div style="margin-bottom: 20px;">
                <label style="display: block; margin-bottom: 8px; font-weight: bold;">Marca</label>
                <input asp-for="Marca" style="width: 100%; padding: 10px; border: 2px solid #dc2626; border-radius: 6px;" placeholder="Ej: Ferrari" />
            </div>

            <div style="margin-bottom: 20px;">
                <label style="display: block; margin-bottom: 8px; font-weight: bold;">Tipo de Motor</label>
                <input asp-for="Motor" style="width: 100%; padding: 10px; border: 2px solid #dc2626; border-radius: 6px;" placeholder="Ej: V12" />
            </div>

            <div style="margin-bottom: 20px;">
                <label style="display: block; margin-bottom: 8px; font-weight: bold;">Año</label>
                <input asp-for="Ano" type="number" style="width: 100%; padding: 10px; border: 2px solid #dc2626; border-radius: 6px;" placeholder="Ej: 2000" />
            </div>

            <div style="margin-bottom: 20px;">
                <label style="display: block; margin-bottom: 8px; font-weight: bold;">Descripción</label>
                <textarea asp-for="Descripcion" style="width: 100%; padding: 10px; border: 2px solid #dc2626; border-radius: 6px; min-height: 100px;" placeholder="Describe el carro..."></textarea>
            </div>

            <div style="display: flex; gap: 15px;">
                <button type="submit" class="btn btn-primary" style="flex: 1;">Guardar Carro</button>
                <a href="@Url.Action("Index", "Catalogo")" class="btn btn-outline" style="flex: 1; text-align: center;">Cancelar</a>
            </div>
        </form>
    </div>
</div>
